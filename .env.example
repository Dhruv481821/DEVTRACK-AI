# Copy to .env and fill in real values locally. Never commit .env itself.
# Full explanation of each variable: /docs/15_Deployment.md §2.

# --- Backend (local dev matches docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/devtrack_dev
DB_USERNAME=devtrack
DB_PASSWORD=devtrack_local_only

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Prod only: https://<your-vercel-domain>/login/oauth2/code/google
GOOGLE_OAUTH_REDIRECT_URI=

CORS_ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Frontend ---
# Local: the backend URL. Production (Vercel): set it to an EMPTY value so the app calls
# /api on its own domain and vercel.json proxies it to Railway (keeps auth cookies first-party).
VITE_API_BASE_URL=http://localhost:8080
# Public support email shown on Contact/Terms/Privacy/Refund pages (Razorpay KYC checks these).
VITE_SUPPORT_EMAIL=

# --- Added in later phases, not needed yet (see 15_Deployment.md §2) ---
# REDIS_URL=                       (Phase 2)
# GITHUB_OAUTH_CLIENT_ID=          (Phase 2)
# GITHUB_OAUTH_CLIENT_SECRET=      (Phase 2)
# GITHUB_OAUTH_REDIRECT_URI=       (prod: https://<your-vercel-domain>/api/v1/github/callback)
# TOKEN_ENCRYPTION_KEY=            (Phase 2)
# GEMINI_API_KEY=                  (Phase 5)

# --- Billing (Razorpay). Use TEST keys (rzp_test_...) locally; live keys only in prod. ---
# Dashboard -> Account & Settings -> API Keys. Webhook secret: Dashboard -> Webhooks.
# Leave blank to run with billing disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
