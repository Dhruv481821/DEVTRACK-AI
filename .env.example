# Copy to .env and fill in real values locally. Never commit .env itself.
# Full explanation of each variable: /docs/15_Deployment.md §2.

# --- Backend (local dev matches docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/devtrack_dev
DB_USERNAME=devtrack
DB_PASSWORD=devtrack_local_only

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

RESEND_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

CORS_ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080

